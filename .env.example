# Copy to .env.local and fill in. Every value is optional for local work:
# without Supabase the bundled site in content/sites is used and RSVPs are
# logged to the terminal; without Stripe the checkout button is disabled.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- RSVP notification email (Resend) ---
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "RSVPs <rsvp@yourdomain.com>"
RSVP_FROM_EMAIL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# "payment" (one-time, default) or "subscription"
STRIPE_CHECKOUT_MODE=payment

# --- Routing (pick one, or neither for path-based /<slug> URLs) ---
# One deployment per couple: "/" serves this site.
DEFAULT_SITE_SLUG=
# One multi-tenant app: <slug>.<root domain> serves /<slug>.
NEXT_PUBLIC_ROOT_DOMAIN=
