# Copy to .env.local and fill in. Without Supabase the bundled site in
# content/sites is used and RSVPs are logged to the terminal, but photos and
# videos (which live in Supabase Storage) will not load.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Photos, theme images and videos come from the public "site-media" Storage
# bucket, found automatically from NEXT_PUBLIC_SUPABASE_URL. Only set this to
# serve them from somewhere else (for example a CDN in front of the bucket).
NEXT_PUBLIC_MEDIA_URL=

# --- RSVP notification email (Resend) ---
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "RSVPs <rsvp@yourdomain.com>"
RSVP_FROM_EMAIL=

# --- Routing ---
# The site shown at "/". Defaults to the Theme 1 reference site (amali-ashen).
DEFAULT_SITE_SLUG=
# Optional multi-tenant mode: <slug>.<root domain> serves /<slug>.
NEXT_PUBLIC_ROOT_DOMAIN=
