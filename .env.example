# Copy to .env.local and fill in. Every value is optional for local work:
# without Supabase the bundled site in content/sites is used and RSVPs are
# logged to the terminal.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Serve theme assets (backgrounds, icons, envelope video) from Supabase
# Storage. `npm run media:migrate` prints the value once the files are copied.
# Leave empty to keep using the original Wix files.
NEXT_PUBLIC_MEDIA_URL=

# --- RSVP notification email (Resend) ---
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "RSVPs <rsvp@yourdomain.com>"
RSVP_FROM_EMAIL=

# --- Routing ---
# The site shown at "/". Defaults to the Theme 1 reference site (amali-ashen).
DEFAULT_SITE_SLUG=
# Optional multi-tenant mode: <slug>.<root domain> serves /<slug>.
NEXT_PUBLIC_ROOT_DOMAIN=
